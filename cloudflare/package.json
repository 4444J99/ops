{
  "name": "ops-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "python3 scripts/release.py --apply",
    "deploy:staging": "node -e \"throw new Error('Staging is non-executing; use local contract tests, not a second production scheduler')\"",
    "deploy:production": "python3 scripts/release.py --apply",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check:boundaries": "node scripts/verify-boundaries.mjs",
    "test:isolated": "node --test test/isolated-runs.test.mjs",
    "release:preflight": "python3 scripts/release.py"
  },
  "dependencies": {
    "cron-parser": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240903.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^3.80.0"
  }
}
